#!/usr/bin/env python3

# Regenerate HolidayData.js from the python-holidays library
# (https://github.com/vacanza/holidays), which tracks public holidays for
# ~150 countries, lunar-calendar ones included.
#
#   pip install holidays
#   bin/generate-holidays            # default countries
#   bin/generate-holidays US KH TH   # any ISO 3166-1 alpha-2 codes
#
# The data is baked into the plugin so the calendar never goes online.

import datetime
import json
import pathlib
import sys

import holidays

DEFAULT_COUNTRIES = ["US", "KH"]
YEARS_BACK = 5
YEARS_AHEAD = 10

countries = [c.upper() for c in sys.argv[1:]] or DEFAULT_COUNTRIES
this_year = datetime.date.today().year
years = range(this_year - YEARS_BACK, this_year + YEARS_AHEAD + 1)

data = {}
for country in countries:
    days = holidays.country_holidays(country, years=years, language="en_US")
    data[country] = {
        day.isoformat(): [name.strip() for name in names.split(";")]
        for day, names in sorted(days.items())
    }

out = pathlib.Path(__file__).resolve().parent.parent / "HolidayData.js"
out.write_text(
    "// Generated by bin/generate-holidays from python-holidays "
    f"{holidays.__version__}, {years.start}–{years.stop - 1}. Do not edit.\n"
    "//\n"
    "// country -> \"yyyy-MM-dd\" -> [holiday names]\n"
    f"var HOLIDAYS = {json.dumps(data, ensure_ascii=False, indent=1)}\n"
)
print(f"wrote {out.name}: {', '.join(countries)} for {years.start}–{years.stop - 1}")
