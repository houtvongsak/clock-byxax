#!/usr/bin/env python3

# Regenerate holidays/ from the python-holidays library
# (https://github.com/vacanza/holidays), which tracks public holidays for
# ~200 countries, lunar-calendar ones included.
#
#   pip install holidays
#   bin/generate-holidays
#
# Writes holidays/<CODE>.json ("yyyy-MM-dd" -> [names]) for every country,
# plus holidays/index.json ([{code, name}], sorted by name) for the picker.
# The calendar only loads the countries switched on, and never goes online.
# .github/workflows/holidays.yml runs this yearly, so nobody has to.

import datetime
import json
import pathlib
import re
import shutil
import warnings

import holidays

YEARS_BACK = 5
YEARS_AHEAD = 10

this_year = datetime.date.today().year
years = range(this_year - YEARS_BACK, this_year + YEARS_AHEAD + 1)
out_dir = pathlib.Path(__file__).resolve().parent.parent / "holidays"

# Some countries only have rules up to a certain year; that is fine.
warnings.filterwarnings("ignore", category=UserWarning)

if out_dir.exists():
    shutil.rmtree(out_dir)
out_dir.mkdir()

index = []
seen = set()
for code in holidays.list_supported_countries():
    # Two-letter ISO codes only; the library also registers alpha-3 codes and
    # aliases (UK for GB) that resolve to the same country class.
    if len(code) != 2:
        continue
    days = holidays.country_holidays(code, years=years, language="en_US")
    country = type(days).__mro__[1]
    if country in seen:
        continue
    seen.add(country)

    data = {
        day.isoformat(): [name.strip() for name in names.split(";")]
        for day, names in sorted(days.items())
    }
    (out_dir / f"{code}.json").write_text(json.dumps(data, ensure_ascii=False, separators=(",", ":")) + "\n")
    # The class behind each code is named for the country: UnitedStates.
    index.append({"code": code, "name": re.sub(r"(?<=[a-z])(?=[A-Z])", " ", country.__name__)})

index.sort(key=lambda c: c["name"])
(out_dir / "index.json").write_text(json.dumps({
    "generator": f"python-holidays {holidays.__version__}",
    "years": [years.start, years.stop - 1],
    "countries": index,
}, ensure_ascii=False, indent=1) + "\n")

print(f"wrote {len(index)} countries for {years.start}–{years.stop - 1} to {out_dir.name}/")
