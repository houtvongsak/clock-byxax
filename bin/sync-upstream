#!/bin/bash

# Pull the latest stock omarchy.clock files from the installed Omarchy onto the
# `upstream` branch, then rebase `main` (your changes) on top of it.
# manifest.json is ours (id/name differ from the built-in), so it is not synced.

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
STOCK="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/panels/clock"
cd "$REPO"

[[ -d $STOCK ]] || { echo "stock clock not found at $STOCK" >&2; exit 1; }
[[ -z $(git status --porcelain) ]] || { echo "working tree not clean; commit or stash first" >&2; exit 1; }

version=$(pacman -Q omarchy 2>/dev/null | awk '{print $2}' || echo unknown)
branch=$(git branch --show-current)

git checkout -q upstream
find "$STOCK" -mindepth 1 -maxdepth 1 ! -name manifest.json -exec cp -a {} . \;
git add -A
if git diff --cached --quiet; then
  echo "upstream already matches omarchy $version"
else
  git commit -q -m "Sync stock omarchy.clock from omarchy $version"
  echo "upstream updated to omarchy $version"
fi

git checkout -q "$branch"
git rebase upstream
